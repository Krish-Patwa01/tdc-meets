# Copy to .env and fill in real values. Never commit .env itself.

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me

# The admin account is created on first successful login with these.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace_me

PORT=5000
FRONTEND_URL=http://localhost:3000

# Optional. Without these the backend stores data in JSON files under
# backend/data/, which is fine locally but gets wiped on hosts with an
# ephemeral filesystem. Use the service_role key, not the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
